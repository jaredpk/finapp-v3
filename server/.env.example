# Get these from https://dashboard.plaid.com
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here
PLAID_ENV=sandbox
# Required for OAuth institutions (Chase, Amex). Must also be registered in Plaid Dashboard > API > Allowed redirect URIs.
# Local: http://localhost:5173
# Production: https://finance.elevrics.ai
PLAID_REDIRECT_URI=http://localhost:5173

# Portal assertion — authenticates the browser-facing app. Nothing to set.
# The app verifies an ES256 JWT in X-Elevrics-Assertion against the keys the
# portal publishes at /.well-known/portal-jwks.json. Both values below have
# working defaults, so a deployed instance always verifies — there is no
# unconfigured state. Replaced Cloudflare Access, which replaced the Supabase
# login for the UI. The /oauth/* Supabase flow used by MCP clients is untouched.
# PORTAL_ORIGIN=https://portal.elevrics.ai   # the assertion's `iss`
# PORTAL_AUDIENCE=/finance                   # the assertion's `aud`

# Where the browser-facing app is mounted on portal.elevrics.ai. The portal
# forwards this prefix intact; the server strips it so every route stays
# registered at root. Machine callers (Plaid webhooks, /mcp, /oauth) use the
# unprefixed Fly hostname and are unaffected. Blank to serve at root.
URL_PREFIX=/finance

# Supabase — https://supabase.com/dashboard > project > Settings > API
# Still used by the /oauth/* flow that external MCP clients authorize through.
# No longer used to log in to the app UI — that is Cloudflare Access now.
# SUPABASE_SERVICE_KEY bypasses row-level security and must never reach a client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_KEY=your_service_role_key

# Public origin of this app. Builds the Plaid webhook URL, and is the issuer in
# the OAuth metadata served at /.well-known/oauth-authorization-server. Changing
# it invalidates existing MCP client authorizations, so it must match the
# hostname clients actually use.
# Production: https://finance.elevrics.ai
APP_URL=http://localhost:3001

# Gemini spend guard. Both callers of GEMINI_API_KEY — interactive Ask AI and
# the unattended 8:10 AM receipt scan — price every call against the rate table
# in geminiUsage.js, log it to the gemini_usage table, and check the UTC
# month-to-date total before starting. Both values below have working defaults,
# so the guard is always on; the numbers are ESTIMATES meant to stop a runaway
# bill, and Cloud Billing remains authoritative.
#
# GEMINI_MONTHLY_BUDGET_USD — the monthly ceiling in US DOLLARS. Default 10.
# The settings card warns at 80% of it and the receipt scanner stops dead at
# 100% until the month rolls over; this is the var both the scan's error and the
# card tell you to raise. Anything unparseable, zero or negative falls back to
# the default rather than disabling the guard or blocking every call.
# GEMINI_MONTHLY_BUDGET_USD=10
#
# GEMINI_ASK_CEILING_PCT — how far Ask AI may run past the budget, as a PERCENT
# OF GEMINI_MONTHLY_BUDGET_USD (not dollars). Default 150, i.e. $15 against the
# default $10 budget. Ask AI outlives the scanner's cutoff on purpose: someone
# is waiting on the answer, and this is what keeps "a few dollars over" from
# becoming unbounded. Past it, POST /api/ask returns 503 until the month resets.
# GEMINI_ASK_CEILING_PCT=150
#
# BOTH OF THE TWO ABOVE TAKE A RESTART. They are read ONCE, at import, into
# module-level constants in geminiUsage.js, so editing them in a running process
# changes nothing — and the messages that tell you to raise them (the settings
# card, the scan's error, the 503 from /api/ask) don't say so. On Fly this is
# invisible because `fly secrets set` restarts the machine anyway; locally,
# restart the server. The model and limit knobs below are the opposite — read
# per call — so the two halves of this file behave differently on purpose.

# Which Gemini model each caller uses. Both default to a known-good model, so
# these exist to roll forward to a new release — or back off one that regressed
# — without a deploy. Read PER CALL, unlike the two budget numbers above: the
# next request picks up a change with no restart. An unrecognised name still
# works: it is billed at the highest rate geminiUsage.js knows of and shows up
# as an unpriced call on the settings card, so the budget over-states rather
# than under-states.
# ASK_AI_MODEL=gemini-3.7-flash     # Ask AI's tool-calling loop
# RECEIPT_MODEL=gemini-2.5-flash    # receipt extraction (structured output)

# ASK_MAX_RESULT_CHARS — the biggest single tool result Ask AI will hand the
# model, in characters of JSON. Default 100000. A result over it is REFUSED
# (the model gets a RESULT_TOO_LARGE error and retries with a narrower range or
# a category filter); it is never passed through partially, because partial
# aggregate data still looks complete and produced confidently wrong answers.
# Raising this is not free: every tool result stays in the conversation and is
# re-sent on each following round-trip, so its cost is multiplied by up to
# MAX_ITERATIONS (8). That, not the model's context window, is what keeps the
# number where it is. Empty, junk, zero and negative fall back to the default.
# Read per call, like the model names above and unlike the budget numbers.
# ASK_MAX_RESULT_CHARS=100000

PORT=3001
