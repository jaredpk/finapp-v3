# Get these from https://dashboard.plaid.com
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here
PLAID_ENV=sandbox
# Required for OAuth institutions (Chase, Amex). Must also be registered in Plaid Dashboard > API > Allowed redirect URIs.
# Local: http://localhost:5173
# Production: https://finapp-v3.fly.dev
PLAID_REDIRECT_URI=http://localhost:5173

PORT=3001
